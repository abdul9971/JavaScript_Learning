function simpleDelay(param) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (param) {
                resolve("Operation Success");
            } else {
                reject("Operation Reject");
            }
        })
    })
};

simpleDelay(true)
    .then(res => {
        console.log(res);
    })
    .catch(err => {
        console.log(err);
    })


function colorchg(color, delay) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (color, delay) {
                h1.style.color = color;
                console.log(`${color} Executed`)
                resolve();
            }
            else {
                reject("color not apple");
            }
        }, delay)
    })
}

colorchg("red", 500)
.then(()=>{ return colorchg("blue", 1000)})
.then(()=>{ return colorchg("green", 1500)})
.then(()=>{ return colorchg("orange", 2000)})
.then(()=>{ return colorchg("voilet", 2500)})
.then(()=>{ return colorchg("darkgreen", 3000)})
.catch((err)=>{
    h1.innerText = "The error come";
})

