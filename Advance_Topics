// =============================== Colleges According to the Country and State ===================

let btnclg = document.querySelector("#btnclg");

btnclg.addEventListener("click", () => {
    let clginput = document.querySelector("#clginput").value;
    let clgState = document.querySelector("#clgState").value;
    let clgPara = document.querySelector("#clgpara");

    if (clginput == "" || clginput == " ") {
        alert("Please Enter the Valid Country Name!")
    }
    else if (clgState == "" || clgState == " ") {
        alert("Please Enter the Valid State Name!")
    } else {
        clgData(clginput)
            .then((response) => {
                let clgList = document.querySelector("#clgList");
                clgList.innerText = "";
                for (res of response) {
                    if (res["state-province"] == null) {
                        // console.log(res);
                    }
                    else if (res["state-province"].toLowerCase() == clgState.toLowerCase()) {
                        let li = document.createElement("li");
                        li.innerText = res.name;
                        clgList.appendChild(li)
                    }
                }
            })
    }
})

async function clgData(country) {
    try {
        let url = `http://universities.hipolabs.com/search?name=${country}`;
        let res = await axios.get(url);
        console.log(res.data[0].name);
        return res.data
    } catch (err) {
        console.log("The Error is : ", err)
    }
}


